# APM dependencies
apm_modules/

# Wails build scaffold. Config and packaging sources are inputs; Windows
# metadata (info.json, version.nsh), the downloaded WebView2 bootstrapper and
# build/bin outputs are generated by the tasks, so they stay out of Git.
/build/*
!/build/config.yml
!/build/windows/
/build/windows/*
!/build/windows/Taskfile.yml
!/build/windows/icon.ico
!/build/windows/wails.exe.manifest
!/build/windows/nsis/
/build/windows/nsis/*
!/build/windows/nsis/project.nsi
!/build/windows/nsis/wails_tools.nsh

# Wails arch-specific build outputs that may escape the build/ ignore
/wails_windows_*.syso
