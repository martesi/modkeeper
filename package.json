{
  "name": "shooter",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run bindings:wails && vite",
    "dev:wails": "bun run bindings:wails && bun run dev:wails:frontend",
    "dev:wails:frontend": "WAILS_APP=true WAILS_DEV=true vite --host 127.0.0.1",
    "build": "bun run bindings:wails && tsc -p tsconfig.check.json && vite build",
    "build:wails": "bun run bindings:wails && tsc -p tsconfig.check.json && WAILS_APP=true WAILS_DEV=true vite build",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "lint": "eslint src/redesign src/routes src/main.tsx src/components/ui/dialog.tsx e2e --max-warnings 0",
    "format:check": "prettier --check \"src/redesign/**/*.{ts,tsx,css}\" \"src/routes/**/*.{ts,tsx}\" src/main.tsx \"src/components/ui/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run scripts/check-tokens.ts",
    "test": "bun test src e2e --path-ignore-patterns 'e2e/playwright/**' --parallel=1",
    "test:e2e": "playwright test",
    "test:e2e:install": "nix develop -c go test -p 2 ./backend ./backend/library -run '^(TestActivateInactiveLibraryRecoversInterruptedInstall|TestActivationIsBusyWhileInstallHasPreparedMarker|TestCancelInstallBatchCommitsCompletedArchives|TestCommittedMarkerWriteErrorAfterRenameKeepsCommittedInstall|TestCommittedMarkerWriteFailureRollsBackAndReportsTaskFailure|TestCommittedRecoveryPreservesSnapshotWhenDestinationIsUnavailable|TestCrashAfterCommittedMarkerKeepsUpgradeOnTwoRestarts|TestCrashAfterFreshInstallReplacementRemovesFilesAndManifestEntry|TestCrashAfterInstallManifestPersistRollsBackFilesAndMetadata|TestCrashDuringInstallRecoveryCleanupIsIdempotent|TestInstallCommitMarkerExistsBeforePreparedMarkerRemoval|TestInstallManyArchives|TestInstallProcessT2Journey|TestInstallProcessT2UpgradeJourney|TestPurgeProcessT2CrashAfterQuarantine|TestRecoverInterruptedInstallArtifactsUnit|TestStartRecoversInterruptedInstallArtifacts|TestStartupAndActivationWarnOnInvalidInstallMarkers|TestTaskAdmissionReturnsBusyAndCancelledTaskCanFinish|TestSyncProcessT2CrashAfterMutation)$' -count=1",
    "test:agent": "bun \"$ARCA_E2E_HARNESS\" browser --config .config/arca.toml --",
    "bindings:wails": "wails3 generate bindings -ts -i -dir . -d frontend/bindings ./...",
    "preview": "vite preview",
    "extract": "lingui extract"
  },
  "dependencies": {
    "@lingui/core": "^6.11.0",
    "@lingui/react": "^6.11.0",
    "@tanstack/react-router": "^1.170.46",
    "@wailsio/runtime": "3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@eslint/js": "^9.39.5",
    "@lingui/cli": "^6.11.0",
    "@lingui/vite-plugin": "^6.11.0",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "lingui": {
    "sourceLocale": "en-US",
    "locales": [
      "en-US"
    ],
    "fallbackLocales": {
      "default": "en-US"
    },
    "catalogs": [
      {
        "path": "locales/{locale}",
        "include": [
          "src"
        ]
      }
    ],
    "compileNamespace": "ts"
  },
  "packageManager": "bun@1.4.4"
}
