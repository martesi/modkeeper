{
  "name": "shooter",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "dev:wails": "WAILS_APP=true WAILS_DEV=true vite --host 127.0.0.1",
    "dev:app": "tauri dev",
    "dev:e2e": "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=9222 tauri dev",
    "e2e:native": "bun e2e/native-smoke.ts",
    "e2e:wails": "bun e2e/wails-smoke.ts",
    "build": "tsc -p tsconfig.check.json && vite build",
    "build:wails": "tsc -p tsconfig.check.json && WAILS_APP=true WAILS_DEV=true vite build",
    "build:native": "bun run build:wails && wails3 build",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "lint": "eslint src/redesign src/routes src/main.tsx src/components/ui/dialog.tsx e2e --max-warnings 0",
    "format:check": "prettier --check \"src/redesign/**/*.{ts,tsx,css}\" \"src/routes/**/*.{ts,tsx}\" src/main.tsx \"src/components/ui/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run scripts/check-tokens.ts",
    "test": "bun test --path-ignore-patterns 'e2e/playwright/**'",
    "test:e2e": "playwright test",
    "test:agent": "bun \"$ARCA_E2E_HARNESS\" browser --config .config/arca.toml --",
    "test:rust": "sh scripts/with-rust.sh cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "sh scripts/with-rust.sh cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "bindings:check": "sh scripts/check-bindings.sh",
    "bindings:write": "sh scripts/check-bindings.sh --write",
    "bindings:wails:prune": "bun scripts/prune-wails-bindings.ts",
    "bindings:wails:check": "bun scripts/prune-wails-bindings.ts --check",
    "test:all": "bun run test && bun run test:rust",
    "preview": "vite preview",
    "tauri": "tauri",
    "extract": "lingui extract",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lingui/core": "^6.11.0",
    "@lingui/react": "^6.11.0",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@wailsio/runtime": "3.1.0",
    "ahooks": "^3.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.58.0",
    "semver": "^7.8.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@lingui/cli": "^6.11.0",
    "@lingui/vite-plugin": "^6.11.0",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "lingui": {
    "sourceLocale": "en-US",
    "locales": [
      "en-US"
    ],
    "fallbackLocales": {
      "default": "en-US"
    },
    "catalogs": [
      {
        "path": "locales/{locale}",
        "include": [
          "src"
        ]
      }
    ],
    "compileNamespace": "ts"
  },
  "packageManager": "bun@1.4.4"
}
